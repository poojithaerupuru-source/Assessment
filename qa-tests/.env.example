# Copy this file to .env (git-ignored) and fill in the values.
# In CI, set the same names as GitHub Actions secrets instead.

BASE_URL=http://localhost:3001
BFF_URL=http://localhost:8090

# Seeded users from the Keycloak realm import (docker/compose/keycloak/demo-app-realm.json)
CLAIMANT_EMAIL=
CLAIMANT_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Second claimant for data-isolation tests. Any email/password: the tests create
# this user in Keycloak themselves, because the app's signup is broken (BUG-05).
OTHER_CLAIMANT_EMAIL=
OTHER_CLAIMANT_PASSWORD=

# Keycloak admin API, used only to create the second claimant
# (values: docker-compose.infra.yml, KC_BOOTSTRAP_ADMIN_*)
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
